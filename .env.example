# Resend API key — get from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret used to sign admin session cookies (generate: openssl rand -hex 32)
SESSION_COOKIE_SECRET=replace_with_32_byte_hex_string

# Email address where students can reply with questions (current leadership inbox)
ADMIN_NOTIFICATION_EMAIL=leadership@yourschool.org

# Domain that email is sent from (must be verified in Resend)
FROM_EMAIL=tutoring@yourdomain.org

# School email domain — only this domain can sign up (e.g. yourschool.org)
SCHOOL_EMAIL_DOMAIN=yourschool.org
