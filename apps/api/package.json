{
  "name": "@academy/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply academy-tutoring-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply academy-tutoring-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@academy/shared": "workspace:*",
    "@hono/zod-validator": "^0.2.2",
    "drizzle-orm": "^0.30.10",
    "hono": "^4.3.4",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@react-email/components": "^0.0.19",
    "@react-email/render": "^0.0.17",
    "resend": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240524.0",
    "drizzle-kit": "^0.21.2",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.0"
  }
}
